  m_Name: Flow_Chapter1
  m_EditorClassIdentifier: Assembly-CSharp::FlowDefinition
  notes: "Ch\u01B0\u01A1ng 1 'M\xF3n N\u1EE3 Cu\u1ED1i C\xF9ng': g\u1EA7m xe \u2192
    tin nh\u1EAFn ch\u1EE7 n\u1EE3 \u2192 m\u1EDF c\u1EEDa h\u1EADu \u2192 \xF4 xanh
    ch\u1EA5t \u0111\u1ED3 \u2192 v\xE0o nh\xE0 l\u1EA5y \u0111\u1ED3 \u2192 \u0111\u1EE7
    50M: c\u1EEDa xe l\xE1i t\u1EF1 m\u1EDF, GI\u1EEE E \u0111\u1EC3 tho\xE1t \u2192
    fade \u0111en \u2192 'B\u1EA0N \u0110\xC3 TR\u1EA3 H\u1EBET N\u1EE2'."
  steps:
  - id: S0_ChuiRa
    note: "Ng\u01B0\u1EDDi ch\u01A1i \u1EDF d\u01B0\u1EDBi g\u1EA7m xe, ch\u01B0a
      c\xF3 nhi\u1EC7m v\u1EE5 n\xE0o."
    completeWhen:
      type: 2
      signal: exit_under_truck
      questId: 
      objectiveId: 
      seconds: 0
    onEnter: []
    onExit: []
    nextStepId: S1_TinNhan
  - id: S1_TinNhan
    note: "\u0110i\u1EC7n tho\u1EA1i rung: ch\u1EE7 n\u1EE3 nh\u1EAFc n\u1EE3. Xong
      khi ng\u01B0\u1EDDi ch\u01A1i m\u1EDF tin nh\u1EAFn \u0111\u1ECDc."
    completeWhen:
      type: 9
      signal: 
      questId: 
      objectiveId: 
      seconds: 0
    onEnter:
    - type: 7
      text: "Ng\xE0y mai ph\u1EA3i c\xF3 \u0111\u1EE7 ti\u1EC1n. \u0110\u1EEBng \u0111\u1EC3
        tao ph\u1EA3i t\xECm \u0111\u1EBFn t\u1EADn nh\xE0."
      sender: "Ch\u1EE7 n\u1EE3"
      dialogue: {fileID: 0}
      target: {fileID: 0}
      boolValue: 1
      lightingState: 1
      immediate: 0
    onExit: []
