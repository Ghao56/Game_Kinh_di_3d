<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- Dòng liên kết Style Sheet -->
    <ui:Style src="iPhonePhoneUI.uss" />

    <!-- Nút Icon nhỏ mở điện thoại ngoài góc màn hình -->
    <ui:Button name="btn-toggle-phone" class="phone-icon-btn" text="📱" />

    <!-- Khung Điện Thoại iPhone -->
    <ui:VisualElement class="phone">
        <ui:VisualElement class="screen">

            <!-- Wallpaper Background -->
            <ui:VisualElement class="wallpaper" />

            <!-- Dynamic Island -->
            <ui:VisualElement class="dynamic">
                <ui:VisualElement class="cam" />
            </ui:VisualElement>

            <!-- Status Bar -->
            <ui:VisualElement class="status">
                <ui:Label text="09:41" name="time-label" class="time-text" />
                <ui:VisualElement class="status-right">
                    <ui:Label text="▮▮▮ ⌁" class="status-signal" />
                    <ui:VisualElement class="battery">
                        <ui:VisualElement class="battery-level" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Màn Hình Chính: 6 app, không ScrollView -->
            <ui:VisualElement class="home">
                <ui:VisualElement class="grid">

                    <ui:Button class="app" name="app-safari">
                        <ui:VisualElement class="icon icon-safari"><ui:Label text="🧭" /></ui:VisualElement>
                        <ui:Label text="Safari" class="app-name" />
                    </ui:Button>

                    <ui:Button class="app" name="app-messages">
                        <ui:VisualElement class="icon icon-messages"><ui:Label text="💬" /></ui:VisualElement>
                        <ui:Label text="Tin nhắn" class="app-name" />
                        <ui:Label name="messages-badge" text="" class="badge" />
                    </ui:Button>

                    <ui:Button class="app" name="app-photos">
                        <ui:VisualElement class="icon icon-photos"><ui:Label text="🌈" /></ui:VisualElement>
                        <ui:Label text="Ảnh" class="app-name" />
                    </ui:Button>

                    <ui:Button class="app" name="app-camera">
                        <ui:VisualElement class="icon icon-camera"><ui:Label text="📷" /></ui:VisualElement>
                        <ui:Label text="Camera" class="app-name" />
                    </ui:Button>

                    <ui:Button class="app" name="app-settings">
                        <ui:VisualElement class="icon icon-settings"><ui:Label text="⚙" /></ui:VisualElement>
                        <ui:Label text="Cài đặt" class="app-name" />
                    </ui:Button>

                    <ui:Button class="app" name="app-weather">
                        <ui:VisualElement class="icon icon-weather"><ui:Label text="☀️" /></ui:VisualElement>
                        <ui:Label text="Thời tiết" class="app-name" />
                    </ui:Button>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Thanh Dock bên dưới: 4 app -->
            <ui:VisualElement class="dock">
                <ui:Button class="app dock-app" name="dock-phone">
                    <ui:VisualElement class="icon icon-messages"><ui:Label text="☎" /></ui:VisualElement>
                </ui:Button>
                <ui:Button class="app dock-app" name="dock-safari">
                    <ui:VisualElement class="icon icon-safari"><ui:Label text="🧭" /></ui:VisualElement>
                </ui:Button>
                <ui:Button class="app dock-app" name="dock-messages">
                    <ui:VisualElement class="icon icon-messages"><ui:Label text="💬" /></ui:VisualElement>
                    <ui:Label name="dock-messages-badge" text="" class="badge" />
                </ui:Button>
                <ui:Button class="app dock-app" name="dock-music">
                    <ui:VisualElement class="icon icon-music"><ui:Label text="♫" /></ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <!-- Thanh Home Indicator ở đáy điện thoại -->
            <ui:Button name="btn-home" class="home-indicator" />

            <!-- Trang Tin Nhắn -->
            <ui:VisualElement name="app-page" class="app-page">
                <ui:VisualElement class="apphead">
                    <ui:Label name="app-title" text="Cha" class="app-head-title" />
                    <ui:Button name="btn-close" text="✕" class="close-btn" />
                </ui:VisualElement>

                <ui:ScrollView name="message-scroll" class="appbody" mode="Vertical">
                    <ui:VisualElement name="message-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Thông báo Toast dạng popup -->
            <ui:Label name="toast" class="toast" text="" />

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>