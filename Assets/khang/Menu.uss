/* Nút menu: mặc định xám tối, hover thì sáng trắng */
.menu-button {
    position: absolute;
    left: 50%;
    translate: -50% 0; /* đẩy nút vào giữa màn hình theo chiều ngang */

    /* trong suốt, chỉ hiện chữ */
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-items: center;
    justify-content: center;

    font-size: 46px;
    -unity-font-style: bold;

    /* màu chữ xám tối khi không hover */
    color: rgb(115, 115, 115);

    /* hiệu ứng chuyển màu mượt */
    transition-property: color;
    transition-duration: 0.15s;
}

/* Chuột chỉ vào: sáng lên */
.menu-button:hover {
    color: rgb(255, 255, 255);
}

/* Title logo game: giữ nguyên tỉ lệ 16:9 của ảnh gốc (6000x3375) */
.game-title {
    position: absolute;
    top: 70px;
    left: 50%;
    translate: -50% 0;

    width: 640px;   /* 640 / 360 = 1.7778 → đúng tỉ lệ ảnh, không méo */
    height: 360px;

    background-image: url("project://database/Assets/khang/Title.png?fileID=2800000&guid=e60bde0eefc7dda4794cdd6d78c68908&type=3");
}
